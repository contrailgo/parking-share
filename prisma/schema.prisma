generator client {
  provider = "prisma-client-js"
}

// 로컬 개발은 SQLite(파일 기반, 네트워크 불필요)로 돌아감.
// 배포(Vercel)할 땐 provider를 "postgresql"로 바꾸고 DATABASE_URL을
// Vercel Postgres 연결 문자열로 바꾸면 됨 - 모델 구조는 그대로 써도 됨.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EmployeeType {
  INTERNAL // 내부 배정자 (신관/로비 지정석 보유)
  EXTERNAL // 외부 배정자
  WAITING  // 대기자 (최우선순위)
}

enum LotId {
  basement // 지하 1층 신관
  lobby    // 로비 주차장
}

// 명단의 "버전". data/ 폴더의 "2026_01_07_주차장_배정_명단.xlsx" 같은 파일 하나가
// 버전 하나에 대응됨. effectiveDate는 "이 명단을 몇 월 며칠 예약분부터 적용하는지"를 뜻함.
// 예약/신청 처리 시, 그 예약 날짜 이전(또는 같은) 버전 중 가장 최근 것을 사용함.
model RosterVersion {
  id            String     @id @default(cuid())
  effectiveDate String     @unique // "YYYY-MM-DD" - 이 날짜부터 적용
  sourceFile    String?    // 원본 엑셀 파일명 (참고용, 없어도 됨)
  createdAt     DateTime   @default(now())
  employees     Employee[]
}

// 임직원 명단. 특정 RosterVersion에 속함 - 같은 사람이 버전마다 다른 자리를 가질 수 있음.
// 로비(lot="lobby") 명단은 엑셀에 없는 정보라, 모든 버전에 동일하게 복사되어 들어감.
model Employee {
  id              String        @id @default(cuid())
  name            String
  type            EmployeeType
  lot             LotId?        // 내부 배정자인 경우에만 존재
  spotNumber      Int?          // 내부 배정자인 경우에만 존재
  rosterVersionId String
  rosterVersion   RosterVersion @relation(fields: [rosterVersionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([rosterVersionId, name])
}

// 특정 주차장(lot)·자리(spotNumber)·날짜(date)에 대한 "빈자리 등록".
// 이 행이 존재하는 것 자체가 "초록(빈자리)" 상태를 의미함.
// 삭제되면(취소되면) Request도 같이 삭제됨(onDelete: Cascade).
model Vacancy {
  id           String   @id @default(cuid())
  lot          LotId
  spotNumber   Int
  date         String   // "YYYY-MM-DD" 형식 문자열로 저장 (타임존 문제 방지)
  employeeName String   // 등록한 내부 배정자 이름
  pin          String   // 등록 취소용 4자리 비밀번호
  createdAt    DateTime @default(now())

  request Request?

  @@unique([lot, spotNumber, date])
}

// Vacancy(빈자리)에 대한 신청. 존재하면 파랑(외부) 또는 보라(대기자) 상태가 됨.
// Vacancy가 삭제되면 같이 삭제됨 - 등록 자체가 취소되면 신청도 자동으로 사라짐.
model Request {
  id            String       @id @default(cuid())
  vacancyId     String       @unique
  vacancy       Vacancy      @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  applicantName String
  applicantType EmployeeType // WAITING 또는 EXTERNAL만 들어옴
  pin           String       // 신청 취소용 4자리 비밀번호
  createdAt     DateTime     @default(now())
}
